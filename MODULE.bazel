module(
    name = "appengine-mail-relay",
    version = "0.0.1",
)

bazel_dep(name = "rules_go", version = "0.53.0")
bazel_dep(name = "gazelle", version = "0.42.0")
bazel_dep(name = "rules_python", version = "0.40.0")
bazel_dep(name = "platforms", version = "0.0.10")

# Go configuration
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.23.6")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//client:go.mod")
use_repo(
    go_deps,
    "com_github_breml_rootcerts",
    "com_github_emersion_go_sasl",
    "com_github_emersion_go_smtp",
)

# Python configuration
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = "3.11",
    requirements_lock = "//server:requirements-lock.txt",
)
use_repo(pip, "pip")

# Platform definitions for Go cross-compilation
